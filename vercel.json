{
  "buildCommand": "next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["gru1"],
  "env": [
    {
      "key": "NEXT_PUBLIC_SITE_URL",
      "value": "@site-url"
    }
  ],
  "envs": {
    "production": [
      {
        "key": "NEXT_PUBLIC_SITE_URL",
        "value": "https://www.usehooke.com.br"
      }
    ]
  }
}
